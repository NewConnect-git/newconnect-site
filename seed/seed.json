				{
					"slug": "item_id",
					"label": "項目のID",
					"type": "string"
				},
				{
					"slug": "posted_at",
					"label": "投稿日時",
					"type": "datetime"
				},
				{
					"slug": "thumbnail",
					"label": "サムネイル",
					"type": "json"
				},
				{
