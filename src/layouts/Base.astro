---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SocialLinks from "../components/SocialLinks.astro";
import TermLinks from "../components/TermLinks.astro";
import { loadSiteTerms } from "../utils/terms";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Content reference, for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** The front page shows the big masthead; other pages a compact one. */
	front?: boolean;
	/** Trail from the front page to this page, for BreadcrumbList structured data. The last item is this page. */
	breadcrumbs?: Array<{ name: string; url: string }>;
	/** Marks a standalone page (not a post) with WebPage structured data. */
	webPage?: boolean;
	/** The title already names the site; use it as is (front page). */
	fullTitle?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	front = false,
	breadcrumbs,
	webPage = false,
	fullTitle: titleIsFull = false,
} = Astro.props;

const [settings, primary, footer, social, siteTerms] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("footer"),
	getMenuWithCacheHint("social"),
	// Categories and tags for the bottom of the phone menu
	loadSiteTerms(),
]);
if (Astro.cache?.enabled) {
	for (const result of [settings, primary, footer, social]) {
		if (result?.cacheHint) Astro.cache.set(result.cacheHint);
	}
	for (const hint of siteTerms.cacheHints) Astro.cache.set(hint);
}

const siteTitle = settings.data.title ?? "NewConnect";
// Descriptions written in the admin can hold line breaks; search results show one line.
const metaDescription = description?.replace(/\s+/g, " ").trim() || undefined;
// EmDash's getSeoMeta() already ends post and page titles with " | <site>",
// so the site name is added only when it is not there yet.
const fullTitle =
	titleIsFull || title === siteTitle || title.endsWith(` | ${siteTitle}`) ? title : `${title} | ${siteTitle}`;

const TRAILING_SLASH = /(?<=.)\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "");
const siteUrl = (settings.data.url || Astro.url.origin).replace(/\/$/, "");
const canonicalUrl =
	canonical ?? (robots?.includes("noindex") ? undefined : `${siteUrl}${currentPath}`);

// Share image: the page's own, else the admin's default (Settings > SEO, which
// EmDashHead applies), else the newspaper card in public/og-default.png.
const shareImage =
	image || (settings.data.seo?.defaultOgImage?.url ? undefined : `${siteUrl}/og-default.png`);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: metaDescription,
	canonical: canonicalUrl,
	image: shareImage,
	content,
	seo: { ogImage: shareImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

function isCurrent(url: string): "page" | undefined {
	try {
		const target = new URL(url, Astro.url);
		if (target.origin !== Astro.url.origin) return undefined;
		const path = target.pathname.replace(TRAILING_SLASH, "");
		if (path === currentPath) return "page";
	} catch {
		// not a URL
	}
	return undefined;
}

const isExternal = (url: string) => /^https?:\/\//.test(url) && !url.startsWith(Astro.url.origin);

const year = new Date().getFullYear();

// Structured data EmDash does not add itself (it adds BlogPosting on posts and
// WebSite elsewhere): the organization on the front page, WebPage on standalone
// pages, and the breadcrumb trail.
const absolute = (url: string | undefined | null) => (url ? new URL(url, siteUrl).href : undefined);
const organizationLogo = absolute(settings.data.logo?.url ?? settings.data.favicon?.url);
const structuredData: Record<string, unknown>[] = [];
if (front) {
	structuredData.push({
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": `${siteUrl}/#organization`,
		name: siteTitle,
		url: `${siteUrl}/`,
		...(organizationLogo ? { logo: organizationLogo } : {}),
		...(social?.data?.items?.length ? { sameAs: social.data.items.map((item) => item.url) } : {}),
	});
}
if (webPage && canonicalUrl) {
	structuredData.push({
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: pageTitle ?? title,
		...(metaDescription ? { description: metaDescription } : {}),
		url: canonicalUrl,
		isPartOf: { "@type": "WebSite", name: siteTitle, url: `${siteUrl}/` },
	});
}
if (breadcrumbs && breadcrumbs.length > 1) {
	structuredData.push({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: breadcrumbs.map((crumb, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: crumb.name,
			item: absolute(crumb.url),
		})),
	});
}
// "<" is escaped so text from the admin can never close the script tag.
const structuredDataJson = structuredData.map((data) => JSON.stringify(data).replace(/</g, "\\u003c"));
const primaryItems = primary?.data?.items ?? [];
const footerItems = footer?.data?.items ?? [];
const socialItems = social?.data?.items ?? [];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script is:inline>
			// Apply the reader's saved theme before the first paint.
			try {
				var saved = localStorage.getItem("theme");
				if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
			} catch (e) {}
		</script>
		<EmDashHead page={pageCtx} />
		{structuredDataJson.map((json) => <script type="application/ld+json" set:html={json} />)}
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} の記事`} href="/rss.xml" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip">本文へ移動</a>

		<header class:list={["masthead", { "masthead--front": front }]} id="masthead">
			<div class="wrap masthead__grid">
				{
					front ? (
						<h1 class="masthead__title">
							<a href="/" aria-current="page">{siteTitle}</a>
						</h1>
					) : (
						<p class="masthead__title">
							<a href="/">{siteTitle}</a>
						</p>
					)
				}

				<button type="button" class="theme-toggle" id="theme-toggle">
					<svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" />
					</svg>
					<svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<circle cx="12" cy="12" r="4.5" fill="currentColor" />
						<path
							d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						/>
					</svg>
					<span class="theme-toggle__to-dark">ダークモード</span>
					<span class="theme-toggle__to-light">ライトモード</span>
				</button>

				<button
					type="button"
					class="masthead__burger"
					id="menu-button"
					aria-expanded="false"
					aria-controls="site-menu"
				>
					<span class="masthead__burger-icon" aria-hidden="true"></span>
					<span class="sr-only">メニュー</span>
				</button>

				<!-- On a PC this wrapper disappears (display: contents) and its parts sit
				     in the header grid; on a phone it is the panel the burger opens. -->
				<div class="masthead__panel" id="site-menu">
					<div class="masthead__strip">
						<form method="get" action="/search" role="search" class="masthead__search">
							<label for="site-search" class="sr-only">サイト内を検索</label>
							<input id="site-search" type="search" name="q" placeholder="記事を検索" />
							<button type="submit">検索</button>
						</form>
					</div>

					{
						primaryItems.length > 0 && (
							<nav class="masthead__nav" aria-label="メインメニュー">
								<ul>
									{primaryItems.map((item) => (
										<li>
											<a
												href={item.url}
												aria-current={isCurrent(item.url)}
												target={item.target || undefined}
												rel={isExternal(item.url) ? "noopener" : undefined}
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<SocialLinks items={socialItems} class="masthead__social" />
					<TermLinks
						categories={siteTerms.categories}
						tags={siteTerms.tags}
						headingLevel={2}
						class="masthead__terms"
					/>
				</div>
				<!-- Phone only: dims the page behind the open menu; a tap closes it. -->
				<div class="masthead__scrim" id="menu-scrim" aria-hidden="true"></div>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="colophon">
			<div class="wrap">
				<p class="colophon__title">{siteTitle}</p>
				{
					footerItems.length > 0 && (
						<ul class="colophon__links">
							{footerItems.map((item) => (
								<li>
									<a href={item.url} rel={isExternal(item.url) ? "noopener" : undefined}>
										{item.label}
									</a>
								</li>
							))}
							<li>
								<a href="/rss.xml">RSS</a>
							</li>
						</ul>
					)
				}
				<!-- SNS logos: in the footer on a PC, in the menu on a phone -->
				<SocialLinks items={socialItems} class="colophon__social" />
				<p class="colophon__copy">
					© {year} {siteTitle} · Made with <a href="https://emdashcms.com">EmDash</a>
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
		<script is:inline>
			(function () {
				var button = document.getElementById("theme-toggle");
				if (!button) return;
				var root = document.documentElement;
				var media = window.matchMedia("(prefers-color-scheme: dark)");
				var isDark = function () {
					return root.dataset.theme ? root.dataset.theme === "dark" : media.matches;
				};
				var sync = function () {
					button.toggleAttribute("data-dark", isDark());
				};
				button.addEventListener("click", function () {
					var next = isDark() ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
					sync();
				});
				media.addEventListener("change", sync);
				sync();
			})();

			// Phone menu: the burger slides the panel in from the right, under the
			// header. Esc, the burger again, or a tap on the dimmed page closes it.
			(function () {
				var header = document.getElementById("masthead");
				var button = document.getElementById("menu-button");
				var scrim = document.getElementById("menu-scrim");
				if (!header || !button) return;
				var root = document.documentElement;
				var setOpen = function (open) {
					if (open) header.style.setProperty("--menu-top", header.getBoundingClientRect().bottom + "px");
					header.toggleAttribute("data-open", open);
					root.toggleAttribute("data-menu-open", open);
					button.setAttribute("aria-expanded", String(open));
				};
				button.addEventListener("click", function () {
					setOpen(!header.hasAttribute("data-open"));
				});
				if (scrim) scrim.addEventListener("click", function () {
					setOpen(false);
				});
				// Turning the phone or widening the window to the PC layout closes it.
				window.matchMedia("(min-width: 720px)").addEventListener("change", function (event) {
					if (event.matches) setOpen(false);
				});
				document.addEventListener("keydown", function (event) {
					if (event.key === "Escape" && header.hasAttribute("data-open")) {
						setOpen(false);
						button.focus();
					}
				});
			})();
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
	}

	.skip:focus {
		left: 8px;
		top: 8px;
		z-index: 10;
		padding: 8px 12px;
		background: var(--color-surface);
	}

	.masthead {
		padding-top: 8px;
		margin-bottom: 28px;
	}

	/* PC: theme switch and search at the top right, then the site name on the
	   left and the menu on the right, with one rule underneath. */
	.masthead__grid {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		grid-template-areas:
			". . theme strip"
			"title nav nav nav";
		align-items: center;
		column-gap: 12px;
	}

	.masthead__grid::after {
		content: "";
		grid-column: 1 / -1;
		border-bottom: 1px solid var(--color-rule);
	}

	.masthead__panel {
		display: contents;
	}

	.masthead__burger,
	.masthead__scrim,
	.masthead :global(.masthead__social),
	.masthead :global(.masthead__terms) {
		display: none;
	}

	.masthead__strip {
		grid-area: strip;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 12px;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
	}

	/* Light/dark switch. The label names the mode it switches to;
	   data-dark is set by the script while dark is showing. */
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		grid-area: theme;
		gap: 6px;
		min-height: 30px;
		padding: 0 10px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.theme-toggle:hover {
		border-color: var(--color-rule);
	}

	.theme-toggle__sun,
	.theme-toggle__to-light,
	.theme-toggle[data-dark] .theme-toggle__moon,
	.theme-toggle[data-dark] .theme-toggle__to-dark {
		display: none;
	}

	.theme-toggle[data-dark] .theme-toggle__sun {
		display: block;
	}

	.theme-toggle[data-dark] .theme-toggle__to-light {
		display: inline;
	}

	.masthead__search {
		display: flex;
	}

	.masthead__search input {
		width: 10rem;
		min-height: 30px;
		padding: 2px 8px;
		border: 1px solid var(--color-border);
		border-right: 0;
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
	}

	.masthead__search button {
		min-height: 30px;
		padding: 0 10px;
		border: 1px solid var(--color-rule);
		background: var(--color-text);
		color: var(--color-bg);
		font: inherit;
		cursor: pointer;
	}

	.masthead__title {
		grid-area: title;
		padding-block: 10px 8px;
		font-family: var(--font-sans);
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}

	.masthead__title a {
		text-decoration: none;
	}

	.masthead__nav {
		grid-area: nav;
		justify-self: end;
		min-width: 0;
		max-width: 100%;
	}

	/* On narrow PC/tablet widths the items wrap rather than scroll out of view */
	.masthead__nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
	}

	.masthead__nav li {
		display: flex;
		align-items: center;
		flex: none;
	}

	/* Slashes between items, as in the reference; not read aloud. Set after
	   each item so a wrapped line on phones never starts with one. */
	.masthead__nav li:not(:last-child)::after {
		content: "/" / "";
		padding-inline: 4px;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: 1.0625rem;
	}

	.masthead__nav a {
		display: block;
		padding: 8px 6px;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 500;
		white-space: nowrap;
		text-decoration: none;
	}

	.masthead__nav a:hover,
	.masthead__nav a[aria-current="page"] {
		color: var(--color-brand);
	}

	/* Phone: the header keeps the site name, a theme icon and a menu button,
	   and stays at the top while scrolling. Search and the page tabs open in
	   a panel under it. */
	@media (max-width: 719px) {
		:global(html) {
			scroll-padding-top: 64px;
		}

		.masthead {
			position: sticky;
			top: 0;
			z-index: 20;
			padding-top: 0;
			background: var(--color-bg);
		}

		.masthead__grid {
			grid-template-columns: minmax(0, 1fr) auto auto;
			grid-template-areas: "title theme burger";
			column-gap: 0;
		}

		/* The page behind the open menu does not scroll */
		:global(html[data-menu-open]) {
			overflow: hidden;
		}

		.masthead__title {
			padding-block: 10px;
			font-size: 1.75rem;
		}

		.masthead__burger {
			grid-area: burger;
			display: grid;
			place-items: center;
			width: 44px;
			height: 44px;
			margin-right: -10px;
			border: 0;
			background: none;
			color: var(--color-text);
			cursor: pointer;
		}

		/* Three bars, turning into a cross while the menu is open */
		.masthead__burger-icon,
		.masthead__burger-icon::before,
		.masthead__burger-icon::after {
			display: block;
			width: 22px;
			height: 2px;
			background: currentColor;
			transition: transform var(--transition-fast), background var(--transition-fast);
		}

		.masthead__burger-icon {
			position: relative;
		}

		.masthead__burger-icon::before,
		.masthead__burger-icon::after {
			content: "";
			position: absolute;
			left: 0;
		}

		.masthead__burger-icon::before {
			top: -7px;
		}

		.masthead__burger-icon::after {
			top: 7px;
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon {
			background: transparent;
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon::before {
			transform: translateY(7px) rotate(45deg);
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon::after {
			transform: translateY(-7px) rotate(-45deg);
		}

		/* The menu slides in from the right, under the header */
		.masthead__panel {
			position: fixed;
			top: var(--menu-top, 64px);
			right: 0;
			bottom: 0;
			z-index: 2;
			display: block;
			width: min(320px, 86vw);
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: 16px 20px 24px;
			border-top: 1px solid var(--color-border);
			border-left: 1px solid var(--color-border);
			background: var(--color-bg);
			box-shadow: -12px 0 32px rgb(0 0 0 / 0.14);
			transform: translateX(100%);
			visibility: hidden;
			transition:
				transform 0.25s ease,
				visibility 0s linear 0.25s;
		}

		.masthead[data-open] .masthead__panel {
			transform: none;
			visibility: visible;
			transition: transform 0.25s ease;
		}

		.masthead__scrim {
			position: fixed;
			inset: var(--menu-top, 64px) 0 0 0;
			z-index: 1;
			display: block;
			background: rgb(0 0 0 / 0.4);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity 0.25s ease,
				visibility 0s linear 0.25s;
		}

		.masthead[data-open] .masthead__scrim {
			opacity: 1;
			visibility: visible;
			transition: opacity 0.25s ease;
		}

		@media (prefers-reduced-motion: reduce) {
			.masthead__panel,
			.masthead[data-open] .masthead__panel,
			.masthead__scrim,
			.masthead[data-open] .masthead__scrim {
				transition: none;
			}
		}

		.masthead__search {
			flex: 1;
		}

		.masthead__search input {
			flex: 1;
			width: auto;
			min-height: 40px;
		}

		.masthead__search button {
			min-height: 40px;
			padding-inline: 16px;
		}

		/* Theme switch as an icon only; its label stays for screen readers */
		.theme-toggle {
			justify-content: center;
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			background: none;
		}

		.theme-toggle svg {
			width: 20px;
			height: 20px;
		}

		.theme-toggle span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}

		/* Page tabs as a plain list */
		.masthead__nav {
			justify-self: stretch;
			margin-top: 16px;
		}

		.masthead__nav ul {
			display: block;
			overflow: visible;
		}

		.masthead__nav li {
			border-top: 1px solid var(--color-border);
		}

		.masthead__nav li:last-child {
			border-bottom: 1px solid var(--color-border);
		}

		.masthead__nav li:not(:last-child)::after {
			content: none;
		}

		.masthead__nav a {
			width: 100%;
			padding: 12px 0;
			font-size: 1rem;
			white-space: normal;
		}

		/* SNS logos at the bottom of the menu */
		.masthead :global(.masthead__social) {
