---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Base from "../../layouts/Base.astro";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) {
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// A page whose slug starts with another page's slug and "-" sits under that
// page (notionzadankai-request under notionzadankai): it shows in the
// breadcrumbs and lights up that page's menu item. Longest match wins.
const parts = slug.split("-");
const candidates = parts.slice(1).map((_, i) => parts.slice(0, parts.length - 1 - i).join("-"));
let parent: { title: string; slug: string } | null = null;
for (const candidate of candidates) {
	const result = await getEmDashEntry("pages", candidate);
	if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
	if (result.entry) {
		parent = { title: result.entry.data.title, slug: candidate };
		break;
	}
}

const settings = await getSiteSettings();
const seo = getSeoMeta(page, {
	siteTitle: settings.title ?? "NewConnect",
	siteUrl: Astro.url.origin,
	path: `/pages/${slug}`,
});

// Shown above the page, and given to the layout as BreadcrumbList structured data
const crumbs = [
	{ name: "トップ", url: "/" },
	...(parent ? [{ name: parent.title, url: `/pages/${parent.slug}` }] : []),
	{ name: page.data.title, url: seo.canonical ?? `/pages/${slug}` },
];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
	webPage
	breadcrumbs={crumbs}
>
	<article class="wrap page">
		<Breadcrumbs items={crumbs} />
		<h1 class="page__title" {...page.edit.title}>{page.data.title}</h1>
		<div class="prose page__body" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page {
		max-width: calc(720px + var(--gutter) * 2);
	}

	.page__title {
		padding-bottom: 12px;
		border-bottom: 3px double var(--color-rule);
		font-size: clamp(1.625rem, 4vw, 2.125rem);
		font-weight: 700;
		line-height: var(--leading-tight);
	}

	.page__body {
		margin-top: 28px;
		max-width: none;
	}
</style>
