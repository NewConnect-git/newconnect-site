			"urlPattern": "/pages/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "bluesky",
			"label": "Bluesky",
			"labelSingular": "Bluesky の投稿",
			"description": "Bluesky Feed プラグインが自動で入れる Bluesky の投稿",
			"supports": [
				"drafts",
				"revisions"
			],
			"fields": [
				{
					"slug": "title",
					"label": "タイトル",
					"type": "string"
				},
				{
					"slug": "text",
