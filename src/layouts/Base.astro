---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/theme.css";
import { loadBluesky } from "../utils/feed";
import { formatStamp, truncate } from "../utils/format";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Content reference, for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** The front page shows the big masthead; other pages a compact one. */
	front?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	front = false,
} = Astro.props;

const [settings, primary, footer, social, bluesky] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("footer"),
	getMenuWithCacheHint("social"),
	// Shown in the phone menu on every page
	loadBluesky(5),
]);
if (Astro.cache?.enabled) {
	for (const result of [settings, primary, footer, social]) {
		if (result?.cacheHint) Astro.cache.set(result.cacheHint);
	}
	for (const hint of bluesky.cacheHints) Astro.cache.set(hint);
}

const siteTitle = settings.data.title ?? "NewConnect";
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;

const TRAILING_SLASH = /(?<=.)\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "");
const siteUrl = (settings.data.url || Astro.url.origin).replace(/\/$/, "");
const canonicalUrl =
	canonical ?? (robots?.includes("noindex") ? undefined : `${siteUrl}${currentPath}`);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonicalUrl,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

function isCurrent(url: string): "page" | undefined {
	try {
		const target = new URL(url, Astro.url);
		if (target.origin !== Astro.url.origin) return undefined;
		const path = target.pathname.replace(TRAILING_SLASH, "");
		if (path === currentPath) return "page";
	} catch {
		// not a URL
	}
	return undefined;
}

const isExternal = (url: string) => /^https?:\/\//.test(url) && !url.startsWith(Astro.url.origin);

const year = new Date().getFullYear();
const primaryItems = primary?.data?.items ?? [];
const footerItems = footer?.data?.items ?? [];
const socialItems = social?.data?.items ?? [];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-serif" />
		<Font cssVariable="--font-masthead" />
		<title>{fullTitle}</title>
		<script is:inline>
			// Apply the reader's saved theme before the first paint.
			try {
				var saved = localStorage.getItem("theme");
				if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
			} catch (e) {}
		</script>
		<EmDashHead page={pageCtx} />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} の記事`} href="/rss.xml" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip">本文へ移動</a>

		<header class:list={["masthead", { "masthead--front": front }]} id="masthead">
			<div class="wrap masthead__grid">
				{
					front ? (
						<h1 class="masthead__title">
							<a href="/" aria-current="page">{siteTitle}</a>
						</h1>
					) : (
						<p class="masthead__title">
							<a href="/">{siteTitle}</a>
						</p>
					)
				}

				<button
					type="button"
					class="masthead__burger"
					id="menu-button"
					aria-expanded="false"
					aria-controls="site-menu"
				>
					<span class="masthead__burger-icon" aria-hidden="true"></span>
					<span class="sr-only">メニュー</span>
				</button>

				<!-- On a PC this wrapper disappears (display: contents) and its parts sit
				     in the header grid; on a phone it is the panel the burger opens. -->
				<div class="masthead__panel" id="site-menu">
				<div class="masthead__strip">
					<button type="button" class="theme-toggle" id="theme-toggle">
						<svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" />
						</svg>
						<svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<circle cx="12" cy="12" r="4.5" fill="currentColor" />
							<path
								d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
							/>
						</svg>
						<span class="theme-toggle__to-dark">ダークモード</span>
						<span class="theme-toggle__to-light">ライトモード</span>
					</button>
					<form method="get" action="/search" role="search" class="masthead__search">
						<label for="site-search" class="sr-only">サイト内を検索</label>
						<input id="site-search" type="search" name="q" placeholder="記事を検索" />
						<button type="submit">検索</button>
					</form>
				</div>

					{
						primaryItems.length > 0 && (
							<nav class="masthead__nav" aria-label="メインメニュー">
								<ul>
									{primaryItems.map((item) => (
										<li>
											<a
												href={item.url}
												aria-current={isCurrent(item.url)}
												target={item.target || undefined}
												rel={isExternal(item.url) ? "noopener" : undefined}
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}

					{
						bluesky.posts.length > 0 && (
							<section class="menu-bluesky" aria-labelledby="menu-bluesky-title">
								<h2 id="menu-bluesky-title" class="menu-bluesky__title">
									更新情報 <span>Bluesky</span>
								</h2>
								<ul>
									{bluesky.posts.map((post) => (
										<li>
											<a href={post.url} rel="noopener">
												<span>{truncate(post.text, 60)}</span>
												<time datetime={post.postedAt.toISOString()}>{formatStamp(post.postedAt)}</time>
											</a>
										</li>
									))}
								</ul>
							</section>
						)
					}
				</div>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="colophon">
			<div class="wrap">
				<p class="colophon__title">{siteTitle}</p>
				{
					(footerItems.length > 0 || socialItems.length > 0) && (
						<ul class="colophon__links">
							{[...footerItems, ...socialItems].map((item) => (
								<li>
									<a href={item.url} rel={isExternal(item.url) ? "noopener" : undefined}>
										{item.label}
									</a>
								</li>
							))}
							<li>
								<a href="/rss.xml">RSS</a>
							</li>
						</ul>
					)
				}
				<p class="colophon__copy">
					© {year} {siteTitle} · Made with <a href="https://emdashcms.com">EmDash</a>
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
		<script is:inline>
			(function () {
				var button = document.getElementById("theme-toggle");
				if (!button) return;
				var root = document.documentElement;
				var media = window.matchMedia("(prefers-color-scheme: dark)");
				var isDark = function () {
					return root.dataset.theme ? root.dataset.theme === "dark" : media.matches;
				};
				var sync = function () {
					button.toggleAttribute("data-dark", isDark());
				};
				button.addEventListener("click", function () {
					var next = isDark() ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
					sync();
				});
				media.addEventListener("change", sync);
				sync();
			})();

			// Phone menu: the burger opens the panel; Esc closes it.
			(function () {
				var header = document.getElementById("masthead");
				var button = document.getElementById("menu-button");
				if (!header || !button) return;
				var setOpen = function (open) {
					header.toggleAttribute("data-open", open);
					button.setAttribute("aria-expanded", String(open));
				};
				button.addEventListener("click", function () {
					setOpen(!header.hasAttribute("data-open"));
				});
				document.addEventListener("keydown", function (event) {
					if (event.key === "Escape" && header.hasAttribute("data-open")) {
						setOpen(false);
						button.focus();
					}
				});
			})();
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
	}

	.skip:focus {
		left: 8px;
		top: 8px;
		z-index: 10;
		padding: 8px 12px;
		background: var(--color-surface);
	}

	.masthead {
		padding-top: 8px;
		margin-bottom: 28px;
	}

	/* PC: search and theme switch in a strip at the top right, then the site
	   name on the left and the menu on the right, with one rule underneath. */
	.masthead__grid {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-areas:
			"strip strip"
			"title nav";
		align-items: center;
		column-gap: 24px;
	}

	.masthead__grid::after {
		content: "";
		grid-column: 1 / -1;
		border-bottom: 1px solid var(--color-rule);
	}

	.masthead__panel {
		display: contents;
	}

	.masthead__burger,
	.menu-bluesky {
		display: none;
	}

	.masthead__strip {
		grid-area: strip;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 12px;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
	}

	/* Light/dark switch. The label names the mode it switches to;
	   data-dark is set by the script while dark is showing. */
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 30px;
		padding: 0 10px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
	}

	.theme-toggle:hover {
		border-color: var(--color-rule);
	}

	.theme-toggle__sun,
	.theme-toggle__to-light,
	.theme-toggle[data-dark] .theme-toggle__moon,
	.theme-toggle[data-dark] .theme-toggle__to-dark {
		display: none;
	}

	.theme-toggle[data-dark] .theme-toggle__sun {
		display: block;
	}

	.theme-toggle[data-dark] .theme-toggle__to-light {
		display: inline;
	}

	.masthead__search {
		display: flex;
	}

	.masthead__search input {
		width: 10rem;
		min-height: 30px;
		padding: 2px 8px;
		border: 1px solid var(--color-border);
		border-right: 0;
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
	}

	.masthead__search button {
		min-height: 30px;
		padding: 0 10px;
		border: 1px solid var(--color-rule);
		background: var(--color-text);
		color: var(--color-bg);
		font: inherit;
		cursor: pointer;
	}

	.masthead__title {
		grid-area: title;
		padding-block: 10px 8px;
		font-family: var(--font-masthead);
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		font-weight: 900;
		line-height: 1.1;
		letter-spacing: 0.01em;
	}

	.masthead__title a {
		text-decoration: none;
	}

	.masthead__nav {
		grid-area: nav;
		justify-self: end;
		min-width: 0;
		max-width: 100%;
	}

	/* On narrow PC/tablet widths the items wrap rather than scroll out of view */
	.masthead__nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
	}

	.masthead__nav li {
		display: flex;
		align-items: center;
		flex: none;
	}

	/* Slashes between items, as in the reference; not read aloud. Set after
	   each item so a wrapped line on phones never starts with one. */
	.masthead__nav li:not(:last-child)::after {
		content: "/" / "";
		padding-inline: 4px;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: 1.0625rem;
	}

	.masthead__nav a {
		display: block;
		padding: 8px 6px;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 500;
		white-space: nowrap;
		text-decoration: none;
	}

	.masthead__nav a:hover,
	.masthead__nav a[aria-current="page"] {
		color: var(--color-brand);
	}

	/* Phone: the header keeps only the site name and a menu button, and stays
	   at the top while scrolling. Search, theme switch, menu and Bluesky
	   updates open in a panel under it. */
	@media (max-width: 719px) {
		:global(html) {
			scroll-padding-top: 64px;
		}

		.masthead {
			position: sticky;
			top: 0;
			z-index: 20;
			padding-top: 0;
			background: var(--color-bg);
		}

		.masthead__grid {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				"title burger"
				"panel panel";
		}

		.masthead__title {
			padding-block: 10px;
			font-size: 1.75rem;
		}

		.masthead__burger {
			grid-area: burger;
			display: grid;
			place-items: center;
			width: 44px;
			height: 44px;
			margin-right: -10px;
			border: 0;
			background: none;
			color: var(--color-text);
			cursor: pointer;
		}

		/* Three bars, turning into a cross while the menu is open */
		.masthead__burger-icon,
		.masthead__burger-icon::before,
		.masthead__burger-icon::after {
			display: block;
			width: 22px;
			height: 2px;
			background: currentColor;
			transition: transform var(--transition-fast), background var(--transition-fast);
		}

		.masthead__burger-icon {
			position: relative;
		}

		.masthead__burger-icon::before,
		.masthead__burger-icon::after {
			content: "";
			position: absolute;
			left: 0;
		}

		.masthead__burger-icon::before {
			top: -7px;
		}

		.masthead__burger-icon::after {
			top: 7px;
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon {
			background: transparent;
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon::before {
			transform: translateY(7px) rotate(45deg);
		}

		.masthead__burger[aria-expanded="true"] .masthead__burger-icon::after {
			transform: translateY(-7px) rotate(-45deg);
		}

		.masthead__panel {
			grid-area: panel;
			display: none;
			max-height: calc(100dvh - 64px);
			overflow-y: auto;
			overscroll-behavior: contain;
			padding-block: 12px 20px;
			border-top: 1px solid var(--color-border);
		}

		.masthead[data-open] .masthead__panel {
			display: block;
		}

		/* Search first, full width, then the theme switch */
		.masthead__strip {
			flex-direction: column;
			align-items: stretch;
			gap: 10px;
			font-size: 0.9375rem;
		}

		.masthead__search {
			order: -1;
		}

		.masthead__search input {
			flex: 1;
			width: auto;
			min-height: 40px;
		}

		.masthead__search button {
			min-height: 40px;
			padding-inline: 16px;
		}

		.theme-toggle {
			align-self: flex-start;
			min-height: 40px;
		}

		/* Page tabs as a plain list */
		.masthead__nav {
			justify-self: stretch;
			margin-top: 16px;
		}

		.masthead__nav ul {
			display: block;
			overflow: visible;
		}

		.masthead__nav li {
			border-top: 1px solid var(--color-border);
		}

		.masthead__nav li:last-child {
			border-bottom: 1px solid var(--color-border);
		}

		.masthead__nav li:not(:last-child)::after {
			content: none;
		}

		.masthead__nav a {
			width: 100%;
			padding: 12px 0;
			font-size: 1rem;
			white-space: normal;
		}

		.menu-bluesky {
			display: block;
			margin-top: 24px;
		}

		.menu-bluesky__title {
			display: flex;
			align-items: baseline;
			gap: 8px;
			padding-block: 6px;
			border-top: 3px double var(--color-rule);
			border-bottom: 1px solid var(--color-rule);
			font-size: 1rem;
			font-weight: 900;
			letter-spacing: 0.08em;
		}

		.menu-bluesky__title span {
			margin-left: auto;
			color: var(--color-muted);
			font-family: var(--font-sans);
			font-size: 0.8125rem;
			font-weight: 400;
			letter-spacing: 0;
		}

		.menu-bluesky li + li {
			border-top: 1px solid var(--color-border);
		}

		.menu-bluesky a {
			display: grid;
			gap: 2px;
			padding-block: 10px;
			font-size: 0.9375rem;
			line-height: var(--leading-snug);
			text-decoration: none;
			overflow-wrap: anywhere;
		}

		.menu-bluesky time {
			color: var(--color-muted);
			font-family: var(--font-sans);
			font-size: 0.8125rem;
		}
	}

	main {
		min-height: 50vh;
	}

	main:focus {
		outline: none;
	}

	.colophon {
		margin-top: 56px;
		padding-block: 24px 40px;
		border-top: 3px double var(--color-rule);
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		text-align: center;
	}

	.colophon__title {
		font-family: var(--font-masthead);
		font-size: 1.5rem;
		font-weight: 900;
	}

	.colophon__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px 20px;
		margin-top: 12px;
	}

	.colophon__links a {
		display: inline-block;
		padding-block: 6px;
	}

	.colophon__copy {
		margin-top: 12px;
		color: var(--color-muted);
	}
</style>
