---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="ページが見つかりません" robots="noindex">
	<div class="wrap notfound">
		<p class="notfound__code">404</p>
		<h1 class="notfound__title">お探しのページは見つかりませんでした</h1>
		<p>NewConnect は 2026年11月にサイトを新しくしました。それより前の記事は、新しいサイトには移していません。</p>
		<form method="get" action="/search" role="search" class="notfound__search">
			<label for="notfound-search" class="sr-only">サイト内を検索</label>
			<input id="notfound-search" type="search" name="q" placeholder="記事を検索" />
			<button type="submit">検索</button>
		</form>
		<p class="notfound__links"><a href="/">トップへ戻る</a>・<a href="/posts">記事の一覧</a>・<a href="/search">検索</a></p>
	</div>
</Base>

<style>
	.notfound {
		max-width: 720px;
		padding-block: 40px;
		text-align: center;
	}

	.notfound__code {
		font-family: var(--font-masthead);
		font-size: 4rem;
		font-weight: 900;
		line-height: 1;
	}

	.notfound__title {
		margin-block: 16px 8px;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.notfound__search {
		display: flex;
		justify-content: center;
		margin-top: 20px;
		font-family: var(--font-sans);
	}

	.notfound__search input {
		width: min(20rem, 70vw);
		min-height: 40px;
		padding: 4px 10px;
		border: 1px solid var(--color-border);
		border-right: 0;
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
	}

	.notfound__search button {
		min-height: 40px;
		padding: 0 14px;
		border: 1px solid var(--color-rule);
		background: var(--color-text);
		color: var(--color-bg);
		font: inherit;
		cursor: pointer;
	}

	.notfound__links {
		margin-top: 16px;
		font-family: var(--font-sans);
	}
</style>
