---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { digestWeekFromSlug, inWeek, isDigestSlug } from "../utils/digest";
import { loadBluesky, loadFeedItems, WEEK_MS, withinWeek } from "../utils/feed";
import { formatDate, formatShortDate, formatStamp, SOURCE_LABELS, truncate } from "../utils/format";

const now = new Date();
const DAY_MS = 24 * 60 * 60 * 1000;

const [posts, feed, bluesky, settings] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12 }),
	loadFeedItems(),
	loadBluesky(5),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (!posts.error) Astro.cache.set(posts.cacheHint);
	for (const hint of [...feed.cacheHints, ...bluesky.cacheHints]) Astro.cache.set(hint);
}

const recentPosts = posts.error ? [] : posts.entries;
// Weekly digests get their own section; the top story and the sidebar list
// are the posts written by hand.
const digest = recentPosts.find((post) => isDigestSlug(post.data.slug));
const sitePosts = recentPosts.filter((post) => !isDigestSlug(post.data.slug));
const [lead, ...otherPosts] = sitePosts;
const morePosts = otherPosts.slice(0, 6);

// The roundup shows the week of the latest digest. Before the first digest
// comes out, it shows the last seven days instead.
const digestWeek = digestWeekFromSlug(digest?.data.slug);
const roundup = digestWeek
	? feed.items.filter((item) => inWeek(item.postedAt, digestWeek))
	: withinWeek(feed.items, now);
const roundupRange = digestWeek
	? `${formatShortDate(digestWeek.start)}〜${formatShortDate(digestWeek.lastDay)}`
	: `${formatShortDate(new Date(now.getTime() - WEEK_MS + DAY_MS))}〜${formatShortDate(now)}`;
// The big slot goes to a video, or failing that anything with a picture.
const roundupLead =
	roundup.find((item) => item.kind === "video" && item.thumbnail) ??
	roundup.find((item) => item.thumbnail) ??
	roundup[0];
const roundupRest = roundup.filter((item) => item !== roundupLead);
const roundupSide = roundupRest.slice(0, 5);
const roundupMore = roundupRest.length - roundupSide.length;
const digestHref = digest ? `/posts/${digest.id}` : null;

// No Bluesky posts and no other posts yet: drop the sidebar column entirely.
const hasSide = bluesky.posts.length > 0 || morePosts.length > 0;
---

<Base
	title={settings.title ?? "NewConnect"}
	description={settings.tagline}
	front
>
	<div class:list={["wrap front", { "front--with-side": hasSide }]}>
		<div class="front__main">
			{
				lead && (
					<article class="lead">
						<div class="lead__text">
							{lead.data.terms?.category?.[0] && (
								<a class="kicker" href={`/category/${lead.data.terms.category[0].slug}`}>
									{lead.data.terms.category[0].label}
								</a>
							)}
							<h2 class="lead__title">
								<a class="headline-link" href={`/posts/${lead.id}`}>
									{lead.data.title}
								</a>
							</h2>
							{lead.data.excerpt && <p class="lead__excerpt">{lead.data.excerpt}</p>}
							{lead.data.publishedAt && (
								<p class="byline">
									<time datetime={lead.data.publishedAt.toISOString()}>
										{formatDate(lead.data.publishedAt)}
									</time>
								</p>
							)}
						</div>
						{lead.data.featured_image && (
							<a class="lead__media" href={`/posts/${lead.id}`} tabindex="-1" aria-hidden="true">
								<Image image={lead.data.featured_image} sizes="(min-width: 960px) 480px, 92vw" priority />
							</a>
						)}
					</article>
				)
			}

			<section class="block roundup" aria-labelledby="roundup-title">
				<header class="roundup__head">
					<h2 id="roundup-title" class="roundup__title">
						{digestHref ? <a class="headline-link" href={digestHref}>週刊まとめ</a> : "今週のまとめ"}
					</h2>
					<span class="roundup__sep" aria-hidden="true">/</span>
					<p class="roundup__note">{roundupRange}に届いた動画と記事</p>
				</header>
				{
					!roundupLead ? (
						<p class="empty-note">この 1 週間に届いた動画と記事はまだありません。</p>
					) : (
						<div class:list={["roundup__grid", { "roundup__grid--single": roundupSide.length === 0 }]}>
							<a class="roundup-lead" href={roundupLead.url} rel="noopener">
								{roundupLead.thumbnail && (
									<span class="roundup-lead__media">
										<img src={roundupLead.thumbnail} alt="" loading="lazy" />
										{roundupLead.kind === "video" && <span class="play" aria-hidden="true" />}
									</span>
								)}
								<span class="label">{SOURCE_LABELS[roundupLead.source] ?? roundupLead.source}</span>
								<span class="roundup-lead__title">{roundupLead.title}</span>
								{roundupLead.summary && (
									<span class="roundup-lead__summary">{truncate(roundupLead.summary, 110)}</span>
								)}
								<time class="byline" datetime={roundupLead.postedAt.toISOString()}>
									{formatStamp(roundupLead.postedAt)}
								</time>
							</a>
							{roundupSide.length > 0 && (
								<ul class="roundup-list">
									{roundupSide.map((item) => (
										<li>
											<a class="roundup-item" href={item.url} rel="noopener">
												<span class="roundup-item__text">
													<span class="label">{SOURCE_LABELS[item.source] ?? item.source}</span>
													<span class="roundup-item__title">{item.title}</span>
													{item.summary && (
														<span class="roundup-item__summary">{truncate(item.summary, 60)}</span>
													)}
													<time class="byline" datetime={item.postedAt.toISOString()}>
														{formatStamp(item.postedAt)}
													</time>
												</span>
												{item.thumbnail && (
													<span class="roundup-item__thumb">
														<img src={item.thumbnail} alt="" loading="lazy" />
													</span>
												)}
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					)
				}
				{
					digestHref ? (
						<p class="more">
							<a href={digestHref}>
								{roundupMore > 0 ? `ほか ${roundupMore} 本も、まとめ記事で読む →` : "まとめ記事を読む →"}
							</a>
						</p>
					) : (
						roundupMore > 0 && (
							<p class="more roundup__later">ほか {roundupMore} 本は、土曜朝の週刊まとめに載ります。</p>
						)
					)
				}
			</section>
		</div>

		{hasSide && (
		<aside class="front__side" aria-label="サイドバー">
			{
				bluesky.posts.length > 0 && (
					<section class="block" aria-labelledby="bluesky-title">
						<div class="section-head">
							<h2 id="bluesky-title" class="section-head__title">更新情報</h2>
							<span class="section-head__note">Bluesky</span>
						</div>
						<ul class="briefs">
							{bluesky.posts.map((post) => (
								<li>
									<a href={post.url} rel="noopener" class="brief">
										<span>{truncate(post.text, 80)}</span>
										<time class="byline" datetime={post.postedAt.toISOString()}>
											{formatStamp(post.postedAt)}
										</time>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				morePosts.length > 0 && (
					<section class="block" aria-labelledby="posts-title">
						<div class="section-head">
							<h2 id="posts-title" class="section-head__title">NewConnect の記事</h2>
						</div>
						<ul class="briefs">
							{morePosts.map((post) => (
								<li>
									<a href={`/posts/${post.id}`} class="brief brief--post">
										<span class="brief__title">{post.data.title}</span>
										{post.data.publishedAt && (
											<time class="byline" datetime={post.data.publishedAt.toISOString()}>
												{formatDate(post.data.publishedAt)}
											</time>
										)}
									</a>
								</li>
							))}
						</ul>
						<p class="more"><a href="/posts">記事の一覧へ →</a></p>
					</section>
				)
			}
		</aside>
		)}
	</div>

	<a href="#" class="to-top" id="to-top">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
		<span aria-hidden="true">TOP</span>
		<span class="sr-only">ページの先頭へ戻る</span>
	</a>

	<script is:inline>
		// Show the back-to-top button once the reader has scrolled down a screen.
		(function () {
			var button = document.getElementById("to-top");
			if (!button) return;
			var update = function () {
				button.toggleAttribute("data-show", window.scrollY > window.innerHeight * 0.8);
			};
			window.addEventListener("scroll", update, { passive: true });
			update();
			button.addEventListener("click", function (event) {
				event.preventDefault();
				var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
				var home = document.querySelector(".masthead__title a");
				if (home) home.focus({ preventScroll: true });
			});
		})();
	</script>
</Base>

<style>
	/* Back-to-top button, bottom right; hidden until the page is scrolled */
	.to-top {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 15;
		display: grid;
		place-items: center;
		align-content: center;
		width: 52px;
		height: 52px;
		border: 1px solid var(--color-rule);
		background: var(--color-text);
		color: var(--color-bg);
		font-family: var(--font-sans);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-decoration: none;
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity var(--transition-fast),
			transform var(--transition-fast),
			visibility var(--transition-fast);
	}

	.to-top[data-show] {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.to-top:hover {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}

	@media (min-width: 720px) {
		.to-top {
			right: 28px;
			bottom: 28px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.to-top {
			transition: none;
		}
	}

	/* minmax(0, 1fr) everywhere: a long unbroken string in a feed item
	   (e.g. "■■■■…" in a YouTube description) must not widen the page. */
	.front,
	.lead,
	.roundup__grid,
	.roundup-lead {
		grid-template-columns: minmax(0, 1fr);
	}

	.front {
		display: grid;
		gap: 32px;
	}

	.front__main,
	.front__side {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	@media (min-width: 960px) {
		.front--with-side {
			grid-template-columns: minmax(0, 1fr) 300px;
			gap: 0;
		}

		.front--with-side .front__main {
			padding-right: 28px;
			border-right: 1px solid var(--color-rule);
		}

		.front__side {
			padding-left: 28px;
		}
	}

	.block + .block,
	.lead + .block {
		margin-top: 36px;
	}

	/* Top story */
	.lead {
		display: grid;
		gap: 20px;
		padding-bottom: 28px;
		border-bottom: 1px solid var(--color-rule);
	}

	@media (min-width: 720px) {
		.lead:has(.lead__media) {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			align-items: start;
		}
	}

	.lead__title {
		margin-top: 6px;
		font-size: clamp(1.625rem, 4vw, 2.375rem);
		font-weight: 700;
		line-height: var(--leading-tight);
	}

	.lead__excerpt {
		margin-top: 14px;
		color: var(--color-text-secondary);
		font-size: 1.0625rem;
		line-height: 1.9;
	}

	.lead .byline {
		margin-top: 12px;
	}

	.lead__media :global(img) {
		width: 100%;
		/* Same shape as the auto thumbnail and share card (1200×630), so its text is not cut off */
		aspect-ratio: 40 / 21;
		object-fit: cover;
		filter: grayscale(0.15) contrast(1.05);
	}

	/* Weekly roundup: a big item on the left, a list with thumbnails on the right */
	.roundup__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-bottom: 20px;
		padding-top: 10px;
		border-top: 3px solid var(--color-brand);
	}

	.roundup__title {
		font-size: 1.375rem;
		font-weight: 700;
	}

	.roundup__sep {
		color: var(--color-brand);
		font-size: 1.375rem;
	}

	.roundup__note {
		color: var(--color-muted);
		font-size: 1.0625rem;
	}

	.roundup__grid {
		display: grid;
		gap: 28px;
	}

	@media (min-width: 720px) {
		.roundup__grid:not(.roundup__grid--single) {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}
	}

	/* Source label: YouTube / note / Zenn / はてなブログ */
	.label {
		width: fit-content;
		padding: 1px 6px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.6;
	}

	.roundup-lead {
		display: grid;
		gap: 8px;
		align-content: start;
		text-decoration: none;
	}

	.roundup-lead__media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		margin-bottom: 6px;
		background: var(--color-fill-strong);
	}

	.roundup-lead__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.roundup-lead__title {
		font-size: clamp(1.375rem, 2.6vw, 1.75rem);
		font-weight: 700;
		line-height: var(--leading-tight);
	}

	.roundup-lead__summary {
		color: var(--color-text-secondary);
		font-size: 1.0625rem;
		line-height: 1.8;
	}

	.play {
		position: absolute;
		left: 14px;
		bottom: 14px;
		width: 56px;
		height: 40px;
		border-radius: 6px;
		background: rgb(0 0 0 / 0.75);
	}

	.play::after {
		content: "";
		position: absolute;
		inset: 11px auto auto 22px;
		border-style: solid;
		border-width: 9px 0 9px 15px;
		border-color: transparent transparent transparent #fff;
	}

	.roundup-list li + li {
		border-top: 1px solid var(--color-border);
	}

	.roundup-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 16px;
		padding-block: 16px;
		text-decoration: none;
	}

	.roundup-list li:first-child .roundup-item {
		padding-top: 0;
	}

	.roundup-item__text {
		display: grid;
		gap: 4px;
		align-content: start;
	}

	.roundup-item__title {
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: var(--leading-snug);
	}

	.roundup-item__summary {
		color: var(--color-text-secondary);
		font-size: 0.875rem;
		line-height: 1.7;
	}

	.roundup-item__thumb {
		width: 80px;
		height: 80px;
		overflow: hidden;
		background: var(--color-fill-strong);
	}

	.roundup-item__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.roundup-lead:hover .roundup-lead__title,
	.roundup-item:hover .roundup-item__title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.roundup__later {
		color: var(--color-muted);
	}

	/* Sidebar briefs */
	.briefs li + li {
		border-top: 1px solid var(--color-border);
	}

	.brief {
		display: grid;
		gap: 2px;
		padding-block: 10px;
		font-size: 0.9375rem;
		line-height: var(--leading-snug);
		text-decoration: none;
	}

	.brief:hover span {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.brief__title {
		font-weight: 700;
	}

	.more {
		margin-top: 8px;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		text-align: right;
	}
</style>
