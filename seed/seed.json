			"supports": [
				"drafts",
				"revisions"
			],
			"fields": [
				{
					"slug": "title",
					"label": "タイトル",
					"type": "string"
				},
				{
					"slug": "summary",
					"label": "概要",
					"type": "text"
				},
				{
					"slug": "item_url",
					"label": "項目のURL",
					"type": "string"
