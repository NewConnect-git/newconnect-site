				"status": "published",
				"taxonomies": {
					"category": [
						"news"
					]
				},
				"data": {
					"title": "NewConnect は新聞の装いになりました",
					"excerpt": "サイトを EmDash に移し、トップページを新聞の一面のように作り直しました。今週届いた記事と動画を毎日まとめて載せます。",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "NewConnect のサイトを WordPress から EmDash に移しました。トップページは新聞の一面のように、その週に届いた記事と YouTube の動画をまとめて載せます。",
									"_key": "s1"
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "一面に載るもの",
									"_key": "s2"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "このサイトの記事のうち、いちばん新しいもの（トップ記事）",
									"_key": "s3"
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b4",
							"children": [
								{
									"_type": "span",
									"text": "直近 7 日間に RSS で届いた note・Zenn・はてなブログの記事",
									"_key": "s4"
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b5",
							"children": [
								{
									"_type": "span",
									"text": "直近 7 日間に公開された YouTube の動画",
									"_key": "s5"
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b6",
							"children": [
								{
									"_type": "span",
									"text": "Bluesky の NewConnect 更新情報",
									"_key": "s6"
								}
