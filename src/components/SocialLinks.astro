---
/**
 * The "social" menu as icons. A known service shows its logo; anything else
 * shows its label. Each link is named by the menu item's label for screen
 * readers, and is at least 44px square to tap.
 */
interface SocialItem {
	url: string;
	label: string;
	target?: string | null;
}

interface Props {
	items: SocialItem[];
	class?: string;
}

const { items, class: className } = Astro.props;

/** 24×24 logo paths, by host. */
const ICONS: Record<string, string> = {
	// Bluesky butterfly (Simple Icons, CC0)
	"bsky.app":
		"M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z",
};

function iconFor(url: string): string | undefined {
	try {
		return ICONS[new URL(url).hostname.replace(/^www\./, "")];
	} catch {
		return undefined;
	}
}
---

{
	items.length > 0 && (
		<ul class:list={["social", className]} aria-label="SNS">
			{items.map((item) => {
				const icon = iconFor(item.url);
				return (
					<li>
						<a
							href={item.url}
							target={item.target || undefined}
							rel="noopener me"
							aria-label={icon ? item.label : undefined}
							title={icon ? item.label : undefined}
						>
							{icon ? (
								<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
									<path d={icon} fill="currentColor" />
								</svg>
							) : (
								item.label
							)}
						</a>
					</li>
				);
			})}
		</ul>
	)
}

<style>
	.social {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}

	.social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.social a:hover,
	.social a:focus-visible {
		color: var(--color-accent);
	}
</style>
