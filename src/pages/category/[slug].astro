---
import { decodeSlug, getTerm } from "emdash";
import Archive from "../../components/Archive.astro";
import { DIGEST_CATEGORY } from "../../utils/digest";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug) : null;
if (!term) {
	return Astro.rewrite("/404");
}
---

<Archive
	title={`カテゴリー：${term.label}`}
	lead={term.description || `「${term.label}」の記事の一覧です。`}
	basePath={`/category/${term.slug}`}
	where={{ category: term.slug }}
	groupByMonth={term.slug === DIGEST_CATEGORY.slug}
/>
